{
  "name": "tea-shop-billing",
  "version": "1.0.0",
  "description": "Tea Shop Billing System",
  "type": "module",
  "scripts": {
    "build": "npm run setup:frontend && npm run setup:db",
    "setup:frontend": "mkdir -p public && cp -r frontend/public/* public/ 2>/dev/null || true",
    "setup:db": "cd backend && npx prisma generate 2>/dev/null || true",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && node server.js",
    "start": "node api/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "@prisma/client": "4.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "prisma": "4.16.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
